# Production Environment Configuration
NODE_ENV=production
PORT=3001

# Database Configuration
MONGO_URI=mongodb://admin:production_password@mongodb:27017/smartstock?authSource=admin&retryWrites=true&w=majority
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=production_password
MONGO_DB_NAME=smartstock

# Redis Configuration
REDIS_URL=redis://:production_redis_password@redis:6379
REDIS_PASSWORD=production_redis_password

# JWT Configuration - CHANGE THESE IN PRODUCTION!
JWT_SECRET=production-super-secret-jwt-key-change-immediately
JWT_REFRESH_SECRET=production-super-secret-refresh-key-change-immediately
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-production-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-production-cloudinary-api-key
CLOUDINARY_API_SECRET=your-production-cloudinary-api-secret

# CORS Configuration
CORS_ORIGIN=https://your-production-domain.com

# Frontend Configuration
VITE_API_URL=https://api.your-production-domain.com/api
VITE_SOCKET_URL=https://api.your-production-domain.com

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-production-email@gmail.com
SMTP_PASS=your-production-app-password

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Session Configuration
SESSION_SECRET=production-session-secret-change-immediately