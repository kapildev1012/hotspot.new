# Performance Optimization Configuration

# Database Performance
MONGO_POOL_SIZE=10
MONGO_BUFFER_MAX_ENTRIES=0
MONGO_USE_UNIFIED_TOPOLOGY=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis Performance
REDIS_POOL_SIZE=10
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_RETRY_ATTEMPTS=3

# Application Performance
NODE_OPTIONS=--max-old-space-size=2048
UV_THREADPOOL_SIZE=16

# Caching Configuration
CACHE_TTL_DEFAULT=300
CACHE_TTL_USER_SESSION=3600
CACHE_TTL_PRODUCT_LIST=600
CACHE_TTL_INVENTORY=180

# Rate Limiting
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=300000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=1000

# Socket.IO Performance
SOCKET_IO_TRANSPORTS=websocket,polling
SOCKET_IO_PING_TIMEOUT=20000
SOCKET_IO_PING_INTERVAL=25000

# File Upload Limits
MAX_FILE_SIZE=10485760
MAX_FILES_PER_REQUEST=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet